---
import settings from '../../config/settings.js';
import '../../styles/index.css';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

export interface Props {
	title?: string;
	description?: string;
	canonicalURL?: URL | string;
	image?: string;
}

const title = Astro.props.title || settings.title;
const description = Astro.props.description || settings.description;
const canonicalURL = Astro.props.canonicalURL || new URL(Astro.url.pathname, Astro.site);
const image = new URL(Astro.props.image || './social.webp', Astro.site);

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Create JSON-LD script content
const jsonLdContent = `{
  "@context": "https://schema.org",
  "@type": "BedAndBreakfast",
  "name": "${t('jsonld.name')}",
  "image": [
    "${t('jsonld.image1')}",
    "${t('jsonld.image2')}"
  ],
  "@id": "${t('jsonld.url')}",
  "url": "${t('jsonld.url')}",
  "telephone": "${t('jsonld.telephone')}",
  "email": "${t('jsonld.email')}",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "${t('jsonld.streetAddress')}",
    "addressLocality": "${t('jsonld.addressLocality')}",
    "postalCode": "${t('jsonld.postalCode')}",
    "addressCountry": "${t('jsonld.addressCountry')}"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": ${t('jsonld.latitude')},
    "longitude": ${t('jsonld.longitude')}
  },
  "priceRange": "${t('jsonld.priceRange')}",
  "amenityFeature": [
    { "@type": "LocationFeatureSpecification", "name": "${t('jsonld.amenity1')}", "value": true },
    { "@type": "LocationFeatureSpecification", "name": "${t('jsonld.amenity2')}", "value": true },
    { "@type": "LocationFeatureSpecification", "name": "${t('jsonld.amenity3')}", "value": false }
  ],
  "description": "${t('jsonld.description')}",
  "checkinTime": "${t('jsonld.checkinTime')}",
  "checkoutTime": "${t('jsonld.checkoutTime')}",
  "containsPlace": {
    "@type": "Room",
    "name": "${t('jsonld.roomName')}",
    "bed": {
      "@type": "BedDetails",
      "type": "${t('jsonld.bedType')}"
    },
    "occupancy": {
      "@type": "QuantitativeValue",
      "maxValue": ${t('jsonld.maxValue')}
    }
  }
}`;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta http-equiv="Content-Language" content="en">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="index, follow">
<link rel="icon" type="image/png" href="/favicon.png" />
<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
<!-- Generator -->
<meta name="generator" content={Astro.generator} />
<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={image} />


<!-- Google Analytics -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-PC3CSK7TJN"></script>
<script>
	var host = window.location.hostname;
	if (host != 'localhost') {
		// Place Google Analytics code here.
		window.dataLayer = window.dataLayer || [];

		function gtag() {
			dataLayer.push(arguments);
		}

		gtag('js', new Date());
		gtag('config', 'G-PC3CSK7TJN');
	}
</script>

<!-- JSON-LD for B&B -->
<script type="application/ld+json" set:html={jsonLdContent}>
</script>
