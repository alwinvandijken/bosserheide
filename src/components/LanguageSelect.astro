---
import { languages } from '../i18n/ui';
import { getLangFromUrl, useTranslatedPath, getRouteFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
const route = getRouteFromUrl(Astro.url);
const currentLocale = lang || 'nl';

// Language to flag emoji mapping
const flagEmoji = {
	en: '🇬🇧',
	nl: '🇳🇱',
	fr: '🇫🇷',
	de: '🇩🇪'
} as const;
---

<div class="language-select-container">
	<select
		class="language-select"
		onChange="window.location.pathname = this.value;"
		aria-label="Select language"
	>
		{Object.entries(languages).map(([lang, label]) => {

			return (
				<option
					value={translatePath(`/${route ? route : ''}`, lang)}
					selected={currentLocale === lang}
				>
					{flagEmoji[lang as keyof typeof flagEmoji]} {label}
				</option>
			);
		})}
	</select>
</div>

<style>
    .language-select-container {
        display: inline-flex;
        align-items: center;
    }

    .language-select {
        appearance: none;
        background: transparent;
        border: 1px solid var(--theme-divider);
        border-radius: 999rem;

        font-family: inherit;
        font-size: var(--text-sm);
        line-height: 1.25rem;
        color: var(--theme-text-lighter);
        cursor: pointer;
    }

    .language-select:hover,
    .language-select:focus {
        color: var(--theme-text);
        border-color: var(--theme-text);
    }

    .language-select:focus {
        outline: none;
        box-shadow: 0 0 0 2px var(--theme-accent);
    }

    /* Custom dropdown arrow */
    .language-select-container::after {
        content: "▼";
        font-size: 0.7em;
        position: absolute;
        right: 1rem;
        top: 50%;
        transform: translateY(-50%);
        pointer-events: none;
        color: var(--theme-text-lighter);
    }

    .language-select-container:hover::after {
        color: var(--theme-text);
    }
</style>
