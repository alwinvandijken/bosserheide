---
import { Carousel, Photo } from 'astro-carousel';

interface Props {
  folder?: string;
}

const { folder = '202506/final/highlights' } = Astro.props;

// Fetch images from the API with the specified folder
const response = await fetch(`${Astro.url.origin}/api/album.json?folder=${folder}`);
const images = await response.json();
---

<Carousel images={images} />

<ul class="entry__entries" id="carouselTargetList">
	{
		images.map((img, i) => (
			<li class="entry__elem">
				<a
					title={img.title}
					href={`./?image=${i}`}
					data-carousel-index={i}
					class="entry__link"
				>
					<Photo {...img} />
				</a>
			</li>
		))
	}
</ul>

<style lang="scss">
  .entry {
    &__entries {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      justify-content: center;
      align-items: center;
      gap: 8px;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    &__elem {
      &:hover {
        cursor: pointer;
      }
    }

    &__img {
      object-fit: contain;
      object-position: center;
      width: 100%;
      min-height: 100%;
    }

    &__link {
      display: block;
    }
  }
</style>
