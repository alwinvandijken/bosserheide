---
interface Props {
  source?: string;
  showTitle?: boolean;
}

const { source = 'apartment', showTitle = true } = Astro.props;

import Container from '../components/core/Container.astro';
import { Icon } from 'astro-icon/components';

// Fetch amenities from API
const response = await fetch(`${Astro.url.origin}/api/amenities.json?source=${source}`);
const amenitiesLists = await response.json();
---

<Container>
	{showTitle && <h1>Voorzieningen</h1>}

	<div class="amenities-grid__container">
	{
		amenitiesLists.map((list) => (
			<div class="amenity-category">
				<p class="amenity-category__title">
					<Icon name={list.icon} width={24} height={24} />
					<strong>{list.title}</strong>
				</p>

				<ul class="amenity-list">
					{list.items.map((item) => (
						<li class="amenity-item">
							{item.icon && <Icon name={item.icon} width={16} height={16} />}
							<span>{item.title}</span>
						</li>
					))}
				</ul>
			</div>
		))
	}
	</div>
</Container>

<style>
    .amenities-grid__container {
        padding: 2rem 0;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 2rem;
    }

    .amenity-category {
        margin-bottom: 1.5rem;
    }

    .amenity-category__title {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 1rem;
        font-size: 1.2rem;
    }

    .amenity-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .amenity-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 0;
        border-bottom: 1px solid rgba(0,0,0,0.05);
    }

    @media (max-width: 768px) {
        .amenities-grid__container {
            grid-template-columns: 1fr;
        }
    }
</style>
